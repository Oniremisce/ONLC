<UserControl
    x:Class="LyricsApp.WinUI.Views.ReplaceOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="using:LyricsApp.WinUI.Views">

    <Grid>
        <!-- 半透明遮罩，拦截下层主界面的点击 -->
        <Border x:Name="MaskBorder" Background="#88000000" Opacity="0"/>

        <!-- 居中浮动面板：尺寸 = 主窗口的 3/4（由 SizeChanged 同步） -->
        <Border x:Name="PanelBorder"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="#22808080" BorderThickness="1"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform"/>
            </Border.RenderTransform>

            <Grid Padding="20" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题(左) + 关闭(右) -->
                <Grid Grid.Row="0">
                    <TextBlock Text="全部替换" FontSize="20" FontWeight="Bold"/>
                    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right"
                            VerticalAlignment="Center" MinWidth="36" Padding="6,2"
                            Background="Transparent" BorderThickness="0"
                            Click="OnCloseClick"/>
                </Grid>

                <!-- 处理结果列表 -->
                <Grid Grid.Row="1" BorderBrush="#DDDDDD" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="200"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="序号" Padding="8,6,0,6"/>
                        <TextBlock Grid.Column="1" Text="歌名" Padding="8,6,0,6"/>
                        <TextBlock Grid.Column="2" Text="状态" Padding="8,6,0,6"/>
                    </Grid>
                    <ListView Grid.Row="1" x:Name="ResultList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="w:ReplaceItemView">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind No}" Padding="8,4,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Padding="8,4,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Status, Mode=OneWay}" Padding="8,4,0,4"
                                               Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <!-- 按钮行：两个入口并排 -->
                <Grid Grid.Row="2" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="NetworkButton" Content="网络歌词"
                            HorizontalAlignment="Stretch" Click="OnNetworkLyricsClick"/>
                    <Button Grid.Column="1" x:Name="LocalButton" Content="本地歌词"
                            HorizontalAlignment="Stretch" Click="OnLocalLyricsClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
