<Window
    x:Class="LyricsApp.WinUI.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:LyricsApp.WinUI.Models"
    xmlns:c="using:LyricsApp.WinUI.Controls">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 内容区：左 1/3 列表 + 右 2/3 编辑/播放 -->
        <Grid Grid.Row="0" Padding="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 左：列表 + 操作按钮 -->
            <Grid Grid.Column="0" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" BorderBrush="#DDDDDD" BorderThickness="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="7*"/>
                            <ColumnDefinition Width="8*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="序号" Padding="8,6,0,6"/>
                        <TextBlock Grid.Column="1" Text="歌名" Padding="8,6,0,6"/>
                        <TextBlock Grid.Column="2" Text="歌手" Padding="8,6,0,6"/>
                    </Grid>
                    <ListView Grid.Row="1" x:Name="SongList" SelectionMode="Single"
                              SelectionChanged="OnSongSelectionChanged"
                              DoubleTapped="OnSongDoubleTapped"
                              AllowDrop="True"
                              DragOver="OnSongListDragOver"
                              Drop="OnSongListDrop">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="m:SongItem">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="7*"/>
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{x:Bind ProcessedBrush, Mode=OneWay}" Padding="8,4,0,4">
                                        <TextBlock Text="{x:Bind No}" TextTrimming="CharacterEllipsis"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{x:Bind Title}" Padding="8,4,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="2" Text="{x:Bind Artist}" Padding="8,4,0,4"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="LoadFolderButton" Content="读取文件夹"
                            HorizontalAlignment="Stretch" Click="OnLoadFolderClick"/>
                    <Button Grid.Column="1" x:Name="MatchLyricsButton" Content="匹配歌词"
                            HorizontalAlignment="Stretch" Click="OnMatchLyricsClick"/>
                    <Button Grid.Column="2" x:Name="ReplaceAllButton" Content="全部替换"
                            HorizontalAlignment="Stretch" Click="OnReplaceAllClick"/>
                </Grid>
            </Grid>

            <!-- 右：标签编辑区 + 歌词/播放器 -->
            <Grid Grid.Column="1" RowSpacing="8" Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="歌名:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="TitleBox" Margin="0,2"/>
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="歌手:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" Grid.Column="3" x:Name="ArtistBox" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="专辑:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="AlbumBox" Margin="0,2"/>
                    <TextBlock Grid.Row="1" Grid.Column="2" Text="比特率:" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="1" Grid.Column="3" x:Name="BitrateBox" IsEnabled="False" Margin="0,2"/>
                </Grid>

                <Grid Grid.Row="1" ColumnSpacing="8" RowSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBox Grid.Column="0" Grid.Row="0" x:Name="LyricsBox"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Microsoft YaHei UI" FontSize="14"/>

                    <Grid Grid.Column="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 封面 + (正在播放标签/控制按钮) 并排 -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="64" Height="64"
                                    BorderBrush="#DDDDDD" BorderThickness="1" Background="#FAFAFA">
                                <Image x:Name="CoverImage" Stretch="Uniform"/>
                            </Border>
                            <Grid Grid.Column="1" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" x:Name="PlayingLabel" Text="未播放（双击列表中的歌曲开始播放）"
                                           Foreground="Gray" FontSize="12" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Bottom"/>
                                <Grid Grid.Row="1" ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" x:Name="PrevButton" Content="上一曲" Click="OnPrevClick"/>
                                    <Button Grid.Column="1" x:Name="PlayPauseButton" Content="播放" Click="OnPlayPauseClick"/>
                                    <Button Grid.Column="2" x:Name="NextButton" Content="下一曲" Click="OnNextClick"/>
                                </Grid>
                            </Grid>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Slider Grid.Column="0" x:Name="TrackSlider" Minimum="0" Maximum="1000"
                                    StepFrequency="1" IsThumbToolTipEnabled="False"
                                    ValueChanged="OnSliderValueChanged"/>
                            <TextBlock Grid.Column="1" x:Name="TimeLabel" Text="00:00 / 00:00"
                                       VerticalAlignment="Center" Foreground="Gray"/>
                        </Grid>

                        <Border Grid.Row="2" BorderBrush="#DDDDDD" BorderThickness="1">
                            <ScrollViewer x:Name="LyricsScroll" VerticalScrollBarVisibility="Hidden">
                                <c:LyricsCanvas x:Name="LyricsView"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Grid Grid.Column="0" Grid.Row="1" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="WriteDataButton" Content="写入数据"
                                HorizontalAlignment="Stretch" Click="OnWriteDataClick"/>
                        <Button Grid.Column="1" x:Name="ManualLyricsButton" Content="手工打词"
                                HorizontalAlignment="Stretch" Click="OnManualLyricsClick"/>
                    </Grid>

                    <!-- 关于：与手工打词一排齐平，位于保存路径按钮上方 -->
                    <Button Grid.Column="1" Grid.Row="1" x:Name="AboutButton" Content="关于"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            MinWidth="72" Click="OnAboutClick"/>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态条 -->
        <Grid Grid.Row="1" Background="#F5F5F5" BorderBrush="#DDDDDD" BorderThickness="0,1,0,0" Padding="10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusTitle" Text="歌名: -" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="1" x:Name="StatusArtist" Text="歌手: -" Margin="0,0,16,0"/>
            <TextBlock Grid.Column="2" x:Name="StatusFile" Text="文件: -" TextTrimming="CharacterEllipsis"/>
            <TextBlock Grid.Column="3" x:Name="SavePathText" Text="未设置保存路径" Margin="16,0,0,0"
                       MaxWidth="380" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
            <Button Grid.Column="4" x:Name="SavePathButton" Content="保存路径" Click="OnSavePathClick"
                    Padding="10,2" MinWidth="0" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </Grid>

        <!-- 悬浮层容器（匹配歌词等）：覆盖整个窗口，无内容时不拦截点击 -->
        <Grid x:Name="OverlayRoot" Grid.Row="0" Grid.RowSpan="2"/>
    </Grid>
</Window>
