<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <RootNamespace>LyricsApp.WinUI</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- 项目信息 -->
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <AssemblyTitle>逐字歌词</AssemblyTitle>
    <Product>逐字歌词</Product>
    <Authors>Oniremisce</Authors>
    <Company>Oniremisce</Company>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>V1.00</InformationalVersion>
    <Copyright>Copyright © Oniremisce</Copyright>
  </PropertyGroup>

  <!-- 图标资源：复制到输出目录供窗口标题栏/打包资产使用 -->
  <ItemGroup>
    <Content Include="..\icon.ico" Link="icon.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\icon.png" Link="icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.2.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- 核心层：播放引擎（Windows Media Foundation）、歌词解析、网络匹配（Core\ 下自包含） -->

</Project>
