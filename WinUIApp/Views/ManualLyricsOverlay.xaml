<UserControl
    x:Class="LyricsApp.WinUI.Views.ManualLyricsOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:c="using:LyricsApp.WinUI.Controls">

    <Grid>
        <!-- 半透明遮罩，拦截下层主界面的点击 -->
        <Border x:Name="MaskBorder" Background="#88000000" Opacity="0"/>

        <!-- 居中浮动面板：尺寸 = 主窗口的 3/4（由 SizeChanged 同步） -->
        <Border x:Name="PanelBorder"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="#22808080" BorderThickness="1"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform"/>
            </Border.RenderTransform>

            <Grid Padding="20" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题(左) + 关闭(右) -->
                <Grid Grid.Row="0">
                    <TextBlock x:Name="TitleText" Text="手工打词" FontSize="20" FontWeight="Bold"/>
                    <Button x:Name="CloseButton" Content="✕" HorizontalAlignment="Right"
                            VerticalAlignment="Center" MinWidth="36" Padding="6,2"
                            Background="Transparent" BorderThickness="0"
                            Click="OnCloseClick"/>
                </Grid>

                <!-- 上方左右并排两个文本框：左=主界面歌词框内容(只读)，右=打词输入 -->
                <Grid Grid.Row="1" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="SourceBox" Header="原歌词（主界面歌词框）"
                             AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             FontFamily="Microsoft YaHei UI" FontSize="13"/>
                    <Grid Grid.Column="1" RowSpacing="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <TextBlock Text="打词输入" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center"/>
                            <!-- 开关：控制覆盖在打词输入框上的滚动歌词框显示/隐藏 -->
                            <ToggleSwitch x:Name="LyricsOverlayToggle" HorizontalAlignment="Right"
                                          OnContent="滚动歌词" OffContent="关闭" MinWidth="120" Margin="0,-4"
                                          Toggled="OnLyricsOverlayToggled"/>
                        </Grid>
                        <Grid Grid.Row="1" x:Name="WorkBoxHost">
                            <TextBox x:Name="WorkBox"
                                 AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="在此输入歌词…"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 FontFamily="Microsoft YaHei UI" FontSize="13"
                                 Padding="10,4,10,4"/>
                            <!-- 滚动歌词框：与打词输入框同位置覆盖，功能同主界面播放器歌词区 -->
                            <ScrollViewer x:Name="OverlayLyricsScroll" Visibility="Collapsed"
                                          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                                          VerticalScrollBarVisibility="Hidden">
                                <c:LyricsCanvas x:Name="OverlayLyricsView"/>
                            </ScrollViewer>
                            <!-- 拖动微调时显示的垂直居中基准虚线（仅滚动歌词框显示时出现） -->
                            <Line x:Name="CenterGuide" X1="0" Y1="0" X2="100" Y2="0"
                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                  Visibility="Collapsed" StrokeThickness="1.5"
                                  StrokeDashArray="4 3" Stroke="#B464A8F0"/>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 波形图进度条（左：播放计时）：整首歌波形，点击/拖动从对应位置播放 -->
                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TimeLabel" Text="00:00" VerticalAlignment="Center"
                               FontFamily="Consolas" FontSize="14" MinWidth="48"/>
                    <c:WaveformBar Grid.Column="1" x:Name="Waveform"/>
                </Grid>

                <!-- 底部：播放/暂停 + 慢放开关 + 歌词时间轴偏移滑杆（气泡显示偏移量）+ 打词/写入 -->
                <Grid Grid.Row="3" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="PlayPauseButton" Content="播放" MinWidth="88"
                            VerticalAlignment="Center" Click="OnPlayPauseClick"/>
                    <ToggleSwitch Grid.Column="1" x:Name="SlowToggle" OnContent="0.7倍速" OffContent="常速"
                                  MinWidth="132" Margin="0,-4" Toggled="OnSlowToggled"/>
                    <Slider Grid.Column="2" x:Name="ProgressSlider" Minimum="0" Maximum="100" Value="50"
                            StepFrequency="0.1" VerticalAlignment="Center"/>
                    <Button Grid.Column="3" x:Name="LyricWordButton" Content="打词" MinWidth="72"
                            VerticalAlignment="Center" Click="OnLyricWordClick"/>
                    <Button Grid.Column="4" x:Name="WriteLyricsButton" Content="写入" MinWidth="72"
                            VerticalAlignment="Center" Click="OnWriteLyricsClick"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
