<UserControl
    x:Class="LyricsApp.WinUI.Views.MatchOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:w="using:LyricsApp.WinUI.Views"
    xmlns:c="using:LyricsApp.WinUI.Controls">

    <Grid>
        <!-- 半透明遮罩，拦截下层主界面的点击 -->
        <Border x:Name="MaskBorder" Background="#88000000" Opacity="0"/>

        <!-- 居中浮动面板：尺寸 = 主窗口的 3/4（由 SizeChanged 同步） -->
        <Border x:Name="PanelBorder"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                CornerRadius="12"
                Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                BorderBrush="#22808080" BorderThickness="1"
                Opacity="0">
            <Border.RenderTransform>
                <TranslateTransform x:Name="PanelTransform"/>
            </Border.RenderTransform>

            <Grid Padding="20" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 标题(左) + 平台Tab搜索(右) 左右并排 -->
                <Grid Grid.Row="0" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="匹配歌词" FontSize="20" FontWeight="Bold"/>
                        <StackPanel Grid.Row="1" Orientation="Vertical" Spacing="2" Margin="0,4,0,0">
                            <TextBlock x:Name="SubtitleLabel" Foreground="#8A919C" FontSize="14"/>
                            <TextBlock x:Name="FileLabel" Foreground="#8A919C" FontSize="12"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Column="1" Spacing="8">
                        <SelectorBar x:Name="PlatformBar" SelectionChanged="OnPlatformChanged">
                            <SelectorBarItem Text="网易云音乐" IsSelected="True"/>
                            <SelectorBarItem Text="LRCLIB"/>
                            <SelectorBarItem Text="QQ 音乐"/>
                            <SelectorBarItem Text="酷狗音乐"/>
                        </SelectorBar>
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="SearchBox" PlaceholderText="输入关键词搜索"
                                     KeyDown="OnSearchBoxKeyDown"/>
                            <Button Grid.Column="1" x:Name="SearchButton" Content="搜索" Click="OnSearchClick"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 主体：候选列表 + 详情 -->
                <Grid Grid.Row="2" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="11*"/>
                        <ColumnDefinition Width="9*"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <ListView x:Name="CandidateList" SelectionMode="Single"
                                  SelectionChanged="OnCandidateSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="w:SongCandidateView">
                                    <Grid Padding="10,8" ColumnSpacing="10" CornerRadius="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="56"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="56" Height="56" CornerRadius="4">
                                            <Image Source="{x:Bind Cover}" Stretch="UniformToFill"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{x:Bind Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                                <Border Background="#33D29922" CornerRadius="8" Padding="6,1">
                                                    <TextBlock Text="{x:Bind ScoreText}" FontSize="11" Foreground="#D29922"/>
                                                </Border>
                                                <Border Visibility="{x:Bind DurationMatchVisibility}"
                                                BorderBrush="#3FB950" BorderThickness="1" CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="时长匹配" FontSize="11" Foreground="#3FB950"/>
                                        </Border>
                                        <Border Visibility="{x:Bind TypeVisibility, Mode=OneWay}"
                                                Background="{x:Bind TypeBrush, Mode=OneWay}"
                                                CornerRadius="8" Padding="6,1">
                                            <TextBlock Text="{x:Bind TypeText, Mode=OneWay}" FontSize="11" Foreground="White"/>
                                        </Border>
                                            </StackPanel>
                                            <TextBlock Text="{x:Bind Subtitle}" FontSize="12" Foreground="#9BA3AD"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock x:Name="ListStatusLabel" Text="正在搜索…" Foreground="#8A919C"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="Visible"/>
                    </Grid>

                    <!-- 详情 -->
                    <Grid Grid.Column="1" RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="120" Height="120" CornerRadius="8">
                                <Image x:Name="CoverImage" Stretch="UniformToFill"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="DetailTitle" FontSize="17" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailArtist" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="DetailAlbum" Foreground="#8A919C" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="SourceBadge" Foreground="#8A919C" FontSize="12" Visibility="Collapsed" Text="歌词  -"/>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ScrollViewer x:Name="PreviewScroll" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PreviewPanel" Spacing="4" Padding="4,0,4,0"/>
                            </ScrollViewer>
                            <!-- 逐字歌词：KTV 逐字染色渲染 -->
                            <Border x:Name="KaraokeHost" Visibility="Collapsed">
                                <ScrollViewer x:Name="KaraokeScroll" VerticalScrollBarVisibility="Hidden">
                                    <c:LyricsCanvas x:Name="KaraokeCanvas" ClearBackground="Transparent"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- 底部：试听控制(左) + 取消/保存(右) -->
                <Grid Grid.Row="3" ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="4*" MaxWidth="420"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="PlayButton" Content="播放" MinWidth="64" Click="OnPlayClick"/>
                    <Slider Grid.Column="1" x:Name="PlaySlider" Minimum="0" Maximum="1000"
                            StepFrequency="1" IsThumbToolTipEnabled="False"
                            VerticalAlignment="Center"
                            ValueChanged="OnPlaySliderValueChanged"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Button x:Name="CancelButton" Content="取消" Click="OnCancelClick"/>
                        <Button x:Name="WriteLyricsButton" Content="写入歌词" Click="OnWriteLyricsClick"/>
                        <Button x:Name="SaveButton" Content="写入歌词+标签" Click="OnSaveClick"/>
                        <Button x:Name="WriteCoverButton" Content="写入封面" Click="OnWriteCoverClick"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
